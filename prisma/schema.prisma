// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime @default(now())
  moves         Move[]
}

model Move {
  id         String   @id @default(uuid())
  userId     String

  // formatted addresses (keep these)
  oldAddress String
  newAddress String

  // current city/state
  oldCity    String?
  oldState   String?
  newCity    String?
  newState   String?

  // source structured address
  oldAddressLine1 String?
  oldAddressLine2 String?
  oldZip          String?
  oldCountry      String? @default("US")
  oldTimezone     String?
  oldLat          Float?
  oldLng          Float?

  // destination structured address
  newAddressLine1 String?
  newAddressLine2 String?
  newZip          String?
  newCountry      String? @default("US")
  newTimezone     String?
  newLat          Float?
  newLng          Float?

  moveDate          DateTime
  lastReminderSent  DateTime?
  paid              Boolean  @default(false)
  createdAt         DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id])
  checklist  ChecklistItem[]
}

model ChecklistItem {
  id          String   @id @default(uuid())
  moveId      String
  category    String
  label       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  move        Move     @relation(fields: [moveId], references: [id])
}
